model Subscription_Plan {
  id        String   @id @default(uuid())
  name      String
  price     Float
  duration  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants  Tenant[]
  features Subscription_Plan_Feature[]

  @@map("subscription_plan")
}

model Subscription_Plan_Feature {
  id                     String   @id @default(uuid())
  subscription_planId    String
  subscription_plan_name String
  featureId              String
  feature_name           String
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  subscription_plan Subscription_Plan @relation(fields: [subscription_planId], references: [id], onDelete: Cascade)
  feature           Feature           @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([subscription_planId, featureId])
  @@map("subscription_plan_feature")
}

model Feature {
  id           String   @id @default(uuid())
  feature_name String   @unique
  feature_code String   @unique
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plans           Subscription_Plan_Feature[]
  tenantsfeatures tenantsfeatures[]

  domains      DomainFeature[]
}

model PlatformPermissionDomain {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  permissions PlatformPermission[]

  @@map("platform_permission_domain")
}


model PlatformPermissionDomainAssignPermission {
  id String @id @default(uuid())
  domainId String
  domain PlatformPermissionDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  permissionId String
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([domainId, permissionId])
  @@map("platform_permission_domain_assign_permission")
}